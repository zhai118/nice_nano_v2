#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/out.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* W+S+TAB 进入蓝牙配对 BT_SEL 0 */
        combo_bt_pair {
            timeout-ms = <60>;
            key-positions = <0 2 11>;
            bindings = <&bt BT_SEL 0>;
            layers = <0 1>;
        };

        /* A+D+TAB 清除全部蓝牙配对 */
        combo_bt_clear_all {
            timeout-ms = <60>;
            key-positions = <1 3 11>;
            bindings = <&bt BT_CLR_ALL>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            label = "BASE";
            bindings = <
                &kp W     &kp A    &kp S    &kp D    &kp SPACE  &kp F
                &kp E     &kp UP   &kp DOWN &kp R    &kp LALT   &lt 1 TAB
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
                &trans    &trans  &trans   &trans   &trans     &trans
                &kp E     &kp UP  &kp DOWN &kp R    &kp LALT   &trans
            >;
        };
    };
};
