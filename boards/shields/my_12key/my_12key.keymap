#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_pair {
            timeout-ms = <60>;
            key-positions = <0 2 11>;
            bindings = <&sys_reset>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp W  &kp A  &kp S  &kp D  &kp SPACE &kp F
                &kp E  &kp UP &kp DOWN &kp R &kp LALT &kp TAB
            >;
        };
    };
};
