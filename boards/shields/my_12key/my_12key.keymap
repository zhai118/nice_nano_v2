#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_pair {
            timeout-ms = <60>;
            key-positions = <0 2 11>;
            bindings = <&bt BT_SEL 0>;
            layers = <0 1>;
        };

        combo_bt_clear_all {
            timeout-ms = <60>;
            key-positions = <1 3 11>;
            bindings = <&bt BT_CLR_ALL>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp W  &kp A  &kp S  &kp D  &kp SPACE &kp F
                &kp E  &kp UP &kp DOWN &kp R &kp LALT &kp TAB
            >;
        };
        fn_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans
                &kp E &kp UP &kp DOWN &kp R &kp LALT &trans
            >;
        };
    };
};
